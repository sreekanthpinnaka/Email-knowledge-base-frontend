# ContextFlow Frontend Environment Configuration
# Toggle mock API mode for testing design and functionality locally without a running backend
VITE_USE_MOCK_API=true

# Set this to your FastAPI backend URL (e.g. https://contextflow-api-xyz-uc.a.run.app or http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Project mailbox where test messages can be sent for ingestion
VITE_PROJECT_GMAIL_ACCOUNT=liveprojectdemo001@gmail.com

# Application Name
VITE_APP_TITLE=ContextFlow
